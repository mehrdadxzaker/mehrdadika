{
  "name": "mehrdadika",
  "version": "0.1.0",
  "type": "module",
  "description": "An open-source visual English–Persian learning atlas with 32 growing subject collections.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test src/**/*.test.ts scripts/*.test.mjs",
    "check:atlas": "npm run check:content",
    "build:atlas": "npm run build:content",
    "format": "prettier --write src vite.config.ts scripts/*.mjs package.json tsconfig.json",
    "check:content": "node scripts/check-content.mjs && node scripts/build-locales.mjs --check",
    "build:content": "node scripts/build-content.mjs",
    "build:locales": "node scripts/build-locales.mjs",
    "check:locales": "node scripts/build-locales.mjs --check",
    "predev": "npm run build:content && npm run build:locales",
    "prebuild": "npm run build:content && npm run build:locales"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "private": true,
  "license": "MIT"
}
